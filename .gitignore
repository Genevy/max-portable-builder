.DS_Store
.idea
.next
.vscode
.history
*.sw?
*.tmp
*.local
*.log

# macOS / Linux artifacts (app, AppImage, deb, desktop, dmg)
*.app
*.AppImage
*.deb
*.desktop
*.dmg

# Windows binaries (MaxPortable.exe, MSI output)
*.msi
*.exe

# Visual Studio files (sln, suo, njsproj)
*.njsproj
*.ntvs*
*.sln
*.suo

# Local AI assistant overrides (shared docs AGENTS.md / CLAUDE.md / .claude are tracked)
CLAUDE.local.md
AGENTS.override.md
.claude/settings.local.json
.agents/settings.local.json
AGENT.md

# Logs (npm, pnpm, yarn, lerna)
lerna-debug.log*
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
logs

# Node / pnpm (node_modules, dist, dist-ssr)
node_modules
dist/*
dist-ssr
journal/
output

# Exceptions for dist (MUST be below dist/*)
!dist/.gitkeep
!dist/about_pake.html
!dist/cli.js

# Tauri generated files (gen, permissions, cargo, pake)
src-tauri/.cargo/
src-tauri/.cargo/config.toml
src-tauri/.pake/
src-tauri/gen/
src-tauri/permissions/autogenerated/

# Generated code review graph files (mmd, json)
code-review-graph.mmd
code-review-graph.json

# Local test artifacts (html, icns)
test-local.html
src-tauri/icons/testapp.icns
src-tauri/icons/localapp.icns
src-tauri/icons/urltest.icns
src-tauri/icons/githubmultiarch.icns

# Portable build output (build/max-portable)
build/

# Tauri bundle output (MSI/NSIS)
bundle/
src-tauri/target/release/bundle/

# Rust build artifacts (target)
target/
src-tauri/target/

# Pake JSON schema (not needed for build)
schema/